import numpy as np
import pandas as pd
from charlie.charlie_foresight.evaluation import (
    summarise_cv_metrics,
    compute_ensemble_cv_metrics,
)

def test_summarise_cv_metrics_basic():
    cv_results = {
        "model_a": [
            {"pred": [1.1, 2.1, 3.1], "actual": [1.0, 2.0, 3.0]},
            {"pred": [0.9, 2.0, 3.2], "actual": [1.0, 2.0, 3.0]},
        ],
        "model_b": [
            {"pred": [1.3, 2.0, 3.3], "actual": [1.0, 2.0, 3.0]},
            {"pred": [1.2, 2.2, 3.1], "actual": [1.0, 2.0, 3.0]},
        ],
    }

    df = summarise_cv_metrics(cv_results)

    assert isinstance(df, pd.DataFrame)
    assert set(df.columns) == {"MAE", "RMSE", "MSE", "MASE"}
    assert set(df.index) == {"model_a", "model_b"}

def test_summarise_cv_metrics_skips_none_preds():
    cv_results = {
        "model_a": [
            {"pred": None, "actual": [1.0, 2.0, 3.0]},
            {"pred": [1.0, 2.0, 3.0], "actual": [1.0, 2.0, 3.0]},
        ]
    }

    df = summarise_cv_metrics(cv_results)

    assert "model_a" in df.index
    assert df.loc["model_a", "MAE"] == 0.0

def test_summarise_cv_metrics_drops_model_with_no_valid_preds():
    cv_results = {
        "bad_model": [
            {"pred": None, "actual": [1, 2, 3]},
            {"pred": None, "actual": [1, 2, 3]},
        ]
    }

    df = summarise_cv_metrics(cv_results)

    assert df.empty

def test_summarise_cv_metrics_sorted_by_mase():
    cv_results = {
        "good": [
            {"pred": [1, 2, 3], "actual": [1, 2, 3]},
        ],
        "bad": [
            {"pred": [10, 20, 30], "actual": [1, 2, 3]},
        ],
    }

    df = summarise_cv_metrics(cv_results)

    assert list(df.index) == ["good", "bad"]

def test_compute_ensemble_cv_metrics_basic():
    cv_results = {
        "a": [
            {"pred": [1, 2, 3], "actual": [1, 2, 3]},
            {"pred": [1, 2, 3], "actual": [1, 2, 3]},
        ],
        "b": [
            {"pred": [2, 3, 4], "actual": [1, 2, 3]},
            {"pred": [2, 3, 4], "actual": [1, 2, 3]},
        ],
    }

    weights = {"a": 0.5, "b": 0.5}

    metrics = compute_ensemble_cv_metrics(cv_results, weights)

    assert set(metrics.keys()) == {"MAE", "RMSE", "MSE", "MASE"}
    assert metrics["MAE"] >= 0

def test_compute_ensemble_ignores_unweighted_models():
    cv_results = {
        "a": [
            {"pred": [1, 2], "actual": [1, 2]},
        ],
        "b": [
            {"pred": [100, 200], "actual": [1, 2]},
        ],
    }

    weights = {"a": 1.0}

    metrics = compute_ensemble_cv_metrics(cv_results, weights)

    assert metrics["MAE"] == 0.0

def test_compute_ensemble_skips_empty_folds():
    cv_results = {
        "a": [
            {"pred": None, "actual": [1, 2]},
            {"pred": [1, 2], "actual": [1, 2]},
        ]
    }

    weights = {"a": 1.0}

    metrics = compute_ensemble_cv_metrics(cv_results, weights)

    assert metrics["MAE"] == 0.0
